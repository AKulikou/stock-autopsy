ANTHROPIC_API_KEY=your-api-key-here

# SEC EDGAR fair access: declare who you are, with a contact email (sec.gov,
# "Accessing EDGAR Data"). Requests without it are refused with 403.
SEC_USER_AGENT=Your Name your-email@example.com

# Experiments, compared in the eval before becoming defaults:
# ANALYSIS_MODEL=claude-sonnet-4-6  # default claude-sonnet-5-5
# THINKING=adaptive                 # default off (no parameter sent; 5.5 models think anyway)
# ANALYSIS_EFFORT=low               # default unset: each model's own default
# PROMPT_CACHING=off                # default on: cache the shared prefix across calls
